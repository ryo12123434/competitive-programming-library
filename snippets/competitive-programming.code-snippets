    "body": [
      "#include \"library/data_structure/implicit_treap.hpp\"",
      "namespace ${1:treap_add} {",
      "using S = ${2:long long};",
      "using F = ${3:long long};",
      "S op(S a, S b) { return ${5:a + b}; }",
      "S e() { return ${6:S(0)}; }",
      "S mapping(F f, S x, int len) { return ${7:x + f * len}; }",
      "F composition(F f, F g) { return ${8:f + g}; } // g の後に f",
      "F id() { return ${9:F(0)}; }",
      "}",
      "using ${4:Treap} = ImplicitTreap<${1}::S, ${1}::op, ${1}::e,",
      "                            ${1}::F, ${1}::mapping, ${1}::composition, ${1}::id>;",
      "$0"
    ]
  },
  "Implicit Treap: affine configuration": {
    "scope": "cpp",
    "prefix": "cp-treap-affine-config",
    "description": "グローバルに挿入。ACL modint の区間アフィン変換・区間和。写像は {倍率, 加算値}。",
    "body": [
      "#include <atcoder/modint>",
      "#include \"library/data_structure/implicit_treap.hpp\"",
      "namespace ${1:treap_affine} {",
      "using S = ${2:atcoder::modint998244353};",
      "struct F { S a, b; };",
      "S op(S a, S b) { return ${4:a + b}; }",
      "S e() { return ${5:S(0)}; }",
      "S mapping(F f, S x, int len) { return ${6:f.a * x + f.b * len}; }",
      "F composition(F f, F g) { return {${7:f.a * g.a, f.a * g.b + f.b}}; } // g の後に f",
      "F id() { return {${8:S(1), S(0)}}; }",
      "}",
      "using ${3:Treap} = ImplicitTreap<${1}::S, ${1}::op, ${1}::e,",
      "                            ${1}::F, ${1}::mapping, ${1}::composition, ${1}::id>;",
      "$0"
    ]
  },

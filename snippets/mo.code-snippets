      "// Mo: #include \"library/algorithm/mo.hpp\" を用意し、関数内で mo-sum / mo-directional。",
      "// Mo mo(n); mo.add_query(l, r);  // 静的配列、0 <= l <= r <= n、区間 [l, r)。",
      "// mo.run(add, erase, output);   // 左右共通の void(int index) と void(int query_id)。",
      "// mo.run(add_left, add_right, erase_left, erase_right, output);  // 順序依存の集計。",
      "// 集計状態は run のたびに空区間 [0, 0) へ初期化する。配列の更新には使わない。",
      "// output の実行順は登録順とは限らない。答えは query_id の位置へ保存する。",
      "// 空区間・重複クエリも可。コールバック内でクエリを変更しない。",
      "// Q 件: 整列 O(Q log Q)、区間操作 O(N sqrt(Q) + Q) 回、追加空間 O(Q)。",
      "// 各コールバックの処理時間は別途必要。",
      "$0"
    ]

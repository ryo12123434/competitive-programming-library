  "Mo: directional callbacks": {
    "scope": "cpp",
    "prefix": "mo-directional",
    "description": "関数内に挿入。mo.hpp を include 済みとする。左右別処理用の枠。初期状態は空区間。空のコールバックを実装してから使う。",
    "body": [
      "Mo ${1:mo}(static_cast<int>(${2:a}.size()));",
      "for (auto [l, r] : ${3:queries}) ${1}.add_query(l, r);",
      "// 集計状態を空区間 [0, 0) に初期化する。",
      "${1}.run(",
      "    [&](int index) { ${4:(void)index; /* 左端に追加 */} },",
      "    [&](int index) { ${5:(void)index; /* 右端に追加 */} },",
      "    [&](int index) { ${6:(void)index; /* 左端から削除 */} },",
      "    [&](int index) { ${7:(void)index; /* 右端から削除 */} },",
      "    [&](int query_id) { ${8:(void)query_id; /* 登録順 ID へ結果を保存 */} }",
      ");",
      "$0"
    ]
  },
  "Mo: quick reference": {

  "Lazy Segment Tree: assign min configuration": {
    "scope": "cpp",
    "prefix": "lazy-assign-min",
    "description": "グローバルに挿入。区間代入・区間最小値。F=optional<ll>（nullopt=操作なし）。Sは区間長を保持。long longのオーバーフローに注意。 初期化は lazy-init。",
    "body": [
      "#include <atcoder/lazysegtree>",
      "#include <vector>",
      "#include <optional>",
      "#include <algorithm>",
      "#include <limits>",
      "namespace ${1:lazy_assign_min} {",
      "using ll = long long;",
      "struct S { ll mn; int len; };",
      "using F = std::optional<ll>;",
      "S op(S a, S b) {",
      "    if (a.len == 0) return b;",
      "    if (b.len == 0) return a;",
      "    return {std::min(a.mn, b.mn), a.len + b.len};",
      "}",
      "S e() { return {std::numeric_limits<ll>::max(), 0}; }",
      "S mapping(F f, S x) {",
      "    if (!f || x.len == 0) return x;",
      "    return {*f, x.len};",
      "}",
      "F composition(F f, F g) { return f ? f : g; } // 先に g、後から f",
      "F id() { return std::nullopt; }",
      "}",
      "using ${2:LazyAssignMin} = atcoder::lazy_segtree<${1}::S, ${1}::op, ${1}::e,",
      "    ${1}::F, ${1}::mapping, ${1}::composition, ${1}::id>;",
      "$0"
    ]
  },
